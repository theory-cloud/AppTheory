{
  "schemaVersion": 1,
  "evidenceDirectory": "gov-infra/evidence/proportionate",
  "localLogDirectory": "gov-infra/evidence/proportionate/local",
  "clockSkewSeconds": 300,
  "securityMaxAgeSeconds": 86400,
  "runner": {
    "maxWorkers": 2,
    "resources": {
      "cpu": 2,
      "repo-write": 1,
      "docker": 1,
      "network": 1
    }
  },
  "proofProfiles": {
    "default": {
      "description": "Operator-approved producing host for portable source, packaging and local-journey proofs; Go pin, Node 24, Python 3.14 on macOS arm64",
      "environment": {
        "go": "go1.27.4",
        "node": "24",
        "python": "3.14",
        "platform": {
          "os": "darwin",
          "arch": "arm64"
        }
      }
    },
    "floor-node22": {
      "description": "Node 22 runtime-floor compatibility for node-bound portable claims (ts pack, CDK Go bindings)",
      "environment": {
        "go": "go1.27.4",
        "node": "22",
        "python": "3.12",
        "platform": {
          "os": "linux",
          "arch": "x64"
        }
      }
    },
    "floor-py3.12": {
      "description": "Python 3.12 runtime-floor compatibility for the Python package build",
      "environment": {
        "go": "go1.27.4",
        "node": "24",
        "python": "3.12",
        "platform": {
          "os": "linux",
          "arch": "x64"
        }
      }
    },
    "floor-node22-py3.12": {
      "description": "Combined Node 22 / Python 3.12 runtime-floor compatibility for the Go/TS/Python contract corpus",
      "environment": {
        "go": "go1.27.4",
        "node": "22",
        "python": "3.12",
        "platform": {
          "os": "linux",
          "arch": "x64"
        }
      }
    },
    "floor-node22-py3.14": {
      "description": "Combined Node 22 / Python 3.14 runtime-floor compatibility for the Go/TS/Python contract corpus",
      "environment": {
        "go": "go1.27.4",
        "node": "22",
        "python": "3.14",
        "platform": {
          "os": "linux",
          "arch": "x64"
        }
      }
    },
    "floor-node24-py3.12": {
      "description": "Combined Node 24 / Python 3.12 runtime-floor compatibility for the Go/TS/Python contract corpus",
      "environment": {
        "go": "go1.27.4",
        "node": "24",
        "python": "3.12",
        "platform": {
          "os": "linux",
          "arch": "x64"
        }
      }
    },
    "linux-x64": {
      "description": "Linux x64 CI producer for platform-bound build proof; a record under this profile is labeled Linux and never substitutes for the macOS default",
      "environment": {
        "go": "go1.27.4",
        "node": "24",
        "python": "3.14",
        "platform": {
          "os": "linux",
          "arch": "x64"
        }
      }
    }
  },
  "nonProductPaths": [
    "docs/",
    "gov-infra/",
    ".github/",
    "scripts/",
    "reference/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    ".gitignore",
    ".golangci-v2.yml",
    "ENUMERATED-CHANGES-improvement-program.md",
    "IMPROVEMENTS.md",
    "LINEAR-PROJECT-improvement-program.md",
    "ROADMAP-improvement-program.md",
    "SCOPED-NEED-improvement-program.md",
    "THEORY_CLOUD.md",
    "UPGRADING.md",
    "llms.txt",
    "release-please-config.json",
    "release-please-config.premain.json",
    "templates/"
  ],
  "releaseOnly": {
    "exact": [
      ".release-please-manifest.json",
      ".release-please-manifest.premain.json",
      "CHANGELOG.md",
      "VERSION",
      "ts/package.json",
      "ts/package-lock.json",
      "cdk/package.json",
      "cdk/package-lock.json",
      "cdk/.jsii",
      "py/pyproject.toml",
      "cdk-go/go.mod",
      "cdk-go/go.sum"
    ],
    "prefixes": [
      "cdk/lib/",
      "cdk-go/apptheorycdk/"
    ],
    "patterns": [
      "examples/cdk/*/package-lock.json"
    ]
  },
  "securityInputs": {
    "exact": [
      "go.mod",
      "go.sum",
      "cdk-go/apptheorycdk/go.mod",
      "cdk-go/apptheorycdk/go.sum",
      "ts/package.json",
      "ts/package-lock.json",
      "cdk/package.json",
      "cdk/package-lock.json",
      "py/pyproject.toml",
      "py/requirements-build.txt",
      "py/requirements-lint.txt",
      "cdk/requirements-build.txt",
      "scripts/local/requirements-examples.txt"
    ],
    "patterns": [
      "examples/cdk/*/package-lock.json"
    ]
  },
  "executionMatrix": [
    {
      "id": "pr-staging",
      "leg": "pull request -> staging",
      "old": "every job executes on the pull-request merge ref",
      "new": "required product jobs reuse applicable evidence for their tracked profile; untrusted or unmatched inputs execute"
    },
    {
      "id": "push-staging",
      "leg": "merge push -> staging",
      "old": "every job re-executes on the merged tree",
      "new": "product and floor jobs reuse each profile's proof for the same inputs; release/security gates execute cheaply"
    },
    {
      "id": "pr-staging-premain",
      "leg": "staging -> premain promotion pull request",
      "old": "CI product set plus promotion readiness and eligibility",
      "new": "promotion readiness/eligibility plus evidenced product checks per profile; no source rerun"
    },
    {
      "id": "push-premain",
      "leg": "promotion merge push -> premain",
      "old": "CI product set re-executes, then release-please generates the RC PR",
      "new": "CI reuses each profile's evidence; release-please generation and artifact sync run"
    },
    {
      "id": "release-pr-premain",
      "leg": "generated RC release PR",
      "old": "dispatched CI re-executes the product suite on generated artifacts",
      "new": "release-delta packaging/drift smoke once; product and floor jobs verify their profile records"
    },
    {
      "id": "release-merge-premain",
      "leg": "RC merge/publish on premain",
      "old": "CI product set re-executes, then the publisher builds assets again",
      "new": "product checks verify profile evidence; signatures and version state run; publisher builds real Linux assets once"
    },
    {
      "id": "pr-premain-main",
      "leg": "premain -> main promotion pull request",
      "old": "CI product set plus promotion readiness and eligibility",
      "new": "promotion readiness/eligibility plus evidenced product checks per profile; no source rerun"
    },
    {
      "id": "push-main",
      "leg": "promotion merge push -> main",
      "old": "CI product set re-executes, then release-please generates the stable PR",
      "new": "CI reuses each profile's evidence; release-please generation and artifact sync run"
    },
    {
      "id": "release-pr-main",
      "leg": "generated stable release PR",
      "old": "dispatched CI re-executes the product suite on generated artifacts",
      "new": "release-delta packaging/drift smoke once; product and floor jobs verify their profile records"
    },
    {
      "id": "release-merge-main",
      "leg": "stable merge/publish on main",
      "old": "CI product set re-executes, then the publisher builds assets again",
      "new": "product checks verify profile evidence; signatures and version state run; publisher builds real Linux assets once"
    },
    {
      "id": "backmerge-main-staging",
      "leg": "main -> staging back-merge pull request",
      "old": "full rubric, builds, examples and matrix re-execute",
      "new": "evidenced pure version-transformation reuse per profile; a real source delta executes the affected gates"
    }
  ],
  "gates": {
    "rubric": {
      "kind": "source",
      "environment": ["go", "node", "python"],
      "profiles": ["default"],
      "description": "Full local rubric gate used by the staging required context; composes independently produced product records and executes only rubric-unique checks",
      "resource": "repo-write",
      "paths": [
        "**"
      ],
      "dependsOn": [
        "go",
        "unit",
        "contract-tests",
        "cdk-go-drift",
        "deterministic-builds"
      ],
      "commands": [
        {
          "id": "rubric",
          "argv": ["make", "rubric"],
          "consumeLog": true,
          "env": {
            "APPTHEORY_EVIDENCE_REUSE": "go,unit,contract-tests,cdk-go-drift,deterministic-builds"
          }
        }
      ]
    },
    "deterministic-builds": {
      "kind": "source",
      "environment": ["go", "node", "python", "platform"],
      "profiles": ["default", "linux-x64"],
      "fallbackProfiles": ["linux-x64"],
      "description": "Deterministic release artifact builds (built twice and compared) on the approved producing host",
      "resources": ["cpu", "repo-write"],
      "paths": [
        "VERSION",
        "ts/",
        "py/",
        "cdk/",
        "third_party/",
        "py/requirements-build.txt",
        "cdk/requirements-build.txt",
        "scripts/verify-builds.sh",
        "scripts/verify-ts-dist-drift.sh",
        "scripts/verify-ts-pack.sh",
        "scripts/verify-python-build.sh",
        "scripts/verify-cdk-ts-pack.sh",
        "scripts/verify-cdk-python-build.sh",
        "scripts/generate-checksums.sh",
        "scripts/read-version.sh",
        "scripts/lib/"
      ],
      "commands": [
        {
          "id": "deterministic-builds",
          "argv": ["bash", "scripts/verify-builds.sh"]
        }
      ]
    },
    "go": {
      "kind": "source",
      "environment": ["go", "node"],
      "profiles": ["default"],
      "description": "Go test and vet",
      "resource": "cpu",
      "paths": [
        "go.mod",
        "go.sum",
        "runtime/",
        "testkit/",
        "pkg/",
        "cmd/",
        "internal/",
        "contract-tests/",
        "examples/",
        "scripts/list-go-packages.sh",
        "scripts/verify-go.sh"
      ],
      "commands": [
        {
          "id": "go-test-vet",
          "argv": [
            "bash",
            "scripts/verify-go.sh"
          ]
        }
      ]
    },
    "unit": {
      "kind": "source",
      "environment": ["go", "node", "python"],
      "profiles": ["default"],
      "description": "Cross-language unit tests (Go unit selection, TypeScript tests, Python tests) composed with the Go gate",
      "resources": ["cpu", "repo-write"],
      "dependsOn": [
        "go"
      ],
      "paths": [
        "go.mod",
        "go.sum",
        "runtime/",
        "testkit/",
        "pkg/",
        "cmd/",
        "internal/",
        "contract-tests/",
        "ts/",
        "py/",
        "scripts/list-go-packages.sh",
        "scripts/verify-go.sh",
        "scripts/verify-unit.sh",
        "scripts/verify-ts-tests.sh",
        "scripts/verify-python-tests.sh",
        "scripts/lib/"
      ],
      "commands": [
        {
          "id": "unit",
          "argv": [
            "bash",
            "scripts/verify-unit.sh"
          ],
          "consumeLog": true,
          "env": {
            "APPTHEORY_EVIDENCE_REUSE": "go"
          }
        }
      ]
    },
    "ts": {
      "kind": "source",
      "environment": ["node"],
      "profiles": ["default", "floor-node22"],
      "description": "TypeScript checked-in dist drift and npm pack",
      "resource": "repo-write",
      "paths": [
        "ts/",
        "scripts/verify-ts-dist-drift.sh",
        "scripts/verify-ts-pack.sh",
        "scripts/read-version.sh",
        "scripts/lib/ts-runtime-deps.sh",
        "scripts/lib/runtime-deps.sh",
        "scripts/lib/retry.sh",
        "scripts/lib/blocked.sh"
      ],
      "commands": [
        {
          "id": "ts-dist-drift",
          "argv": [
            "bash",
            "scripts/verify-ts-dist-drift.sh"
          ],
          "consumeLog": true,
          "env": {
            "APPTHEORY_EVIDENCE_REUSE": "deterministic-builds"
          }
        },
        {
          "id": "ts-pack",
          "argv": [
            "bash",
            "scripts/verify-ts-pack.sh"
          ],
          "consumeLog": true,
          "env": {
            "APPTHEORY_EVIDENCE_REUSE": "deterministic-builds"
          }
        }
      ],
      "dependsOn": [
        "deterministic-builds"
      ],
      "composedFrom": [
        "deterministic-builds"
      ]
    },
    "py": {
      "kind": "source",
      "environment": ["python"],
      "profiles": ["default", "floor-py3.12"],
      "description": "Python wheel and sdist build",
      "resource": "repo-write",
      "paths": [
        "py/",
        "scripts/verify-python-build.sh",
        "scripts/read-version.sh"
      ],
      "commands": [
        {
          "id": "py-build",
          "argv": [
            "bash",
            "scripts/verify-python-build.sh"
          ],
          "consumeLog": true,
          "env": {
            "APPTHEORY_EVIDENCE_REUSE": "deterministic-builds"
          }
        }
      ],
      "dependsOn": [
        "deterministic-builds"
      ],
      "composedFrom": [
        "deterministic-builds"
      ]
    },
    "contract-tests": {
      "kind": "source",
      "environment": ["go", "node", "python"],
      "profiles": [
        "default",
        "floor-node22-py3.12",
        "floor-node22-py3.14",
        "floor-node24-py3.12"
      ],
      "description": "API snapshots and the cross-language contract fixture corpus",
      "resources": ["cpu", "repo-write"],
      "paths": [
        "api-snapshots/",
        "contract-tests/",
        "runtime/",
        "testkit/",
        "pkg/",
        "ts/src/",
        "ts/dist/",
        "py/src/",
        "scripts/verify-api-snapshots.sh",
        "scripts/verify-contract-tests.sh",
        "scripts/verify-fixture-schema.sh",
        "scripts/generate-api-snapshots.sh",
        "scripts/lib/"
      ],
      "commands": [
        {
          "id": "api-snapshots",
          "argv": [
            "bash",
            "scripts/verify-api-snapshots.sh"
          ]
        },
        {
          "id": "contract-fixtures",
          "argv": [
            "bash",
            "scripts/verify-contract-tests.sh"
          ]
        }
      ]
    },
    "cdk-go-drift": {
      "kind": "source",
      "environment": ["go", "node"],
      "profiles": ["default", "floor-node22"],
      "description": "CDK Go bindings regeneration equality",
      "resource": "repo-write",
      "paths": [
        "cdk/",
        "cdk-go/",
        "scripts/update-cdk-generated.sh",
        "scripts/verify-cdk-go-drift.sh",
        "scripts/verify-cdk-go-major-version.sh",
        "scripts/lib/canonicalize-jsii-tarballs.py"
      ],
      "commands": [
        {
          "id": "cdk-go-drift",
          "argv": [
            "bash",
            "scripts/verify-cdk-go-drift.sh"
          ]
        }
      ]
    },
    "examples-local": {
      "kind": "source",
      "environment": ["go", "node", "python", "platform"],
      "profiles": ["default"],
      "description": "Local examples harness plus relocated-copy synth proof (local journey, produced on the approved host)",
      "resources": ["docker", "repo-write"],
      "paths": [
        "Makefile",
        "examples/",
        "scripts/local/",
        "scripts/verify-cdk-synth-location-independent.sh",
        "runtime/",
        "testkit/",
        "pkg/",
        "cmd/apptheory-local/",
        "ts/",
        "contract-tests/",
        "scripts/lib/"
      ],
      "commands": [
        {
          "id": "examples-harness",
          "argv": [
            "make",
            "examples-local"
          ]
        },
        {
          "id": "examples-relocated-synth",
          "argv": [
            "make",
            "verify-cdk-synth-location-independent"
          ]
        }
      ]
    },
    "security-refresh": {
      "kind": "dependency-scan",
      "environment": ["go", "node", "python"],
      "profiles": ["default"],
      "description": "Dependency vulnerability refresh bounded by the tracked max age",
      "maxAgeSeconds": 86400,
      "resource": "network",
      "paths": [
        "go.mod",
        "go.sum",
        "cdk-go/apptheorycdk/go.mod",
        "cdk-go/apptheorycdk/go.sum",
        "ts/package.json",
        "ts/package-lock.json",
        "cdk/package.json",
        "cdk/package-lock.json",
        "py/pyproject.toml",
        "py/requirements-build.txt",
        "py/requirements-lint.txt",
        "cdk/requirements-build.txt",
        "scripts/local/requirements-examples.txt",
        "examples/cdk/*/package-lock.json",
        "scripts/verify-security-refresh.sh",
        "gov-infra/verifiers/gov-verify-rubric.sh"
      ],
      "commands": [
        {
          "id": "security-refresh",
          "argv": [
            "bash",
            "scripts/verify-security-refresh.sh"
          ]
        }
      ]
    },
    "release-delta": {
      "kind": "generated-delta",
      "environment": "none",
      "description": "Narrow packaging and regeneration smoke once per changed generated artifact set; it executes in CI and is never reusable evidence",
      "resource": "repo-write",
      "paths": [
        "**"
      ],
      "commands": [
        {
          "id": "version-alignment",
          "argv": [
            "bash",
            "scripts/verify-version-alignment.sh"
          ]
        },
        {
          "id": "generated-messages",
          "argv": [
            "bash",
            "scripts/verify-release-generated-messages.sh"
          ]
        },
        {
          "id": "cdk-go-regeneration-equality",
          "argv": [
            "bash",
            "scripts/verify-cdk-go-drift.sh"
          ]
        },
        {
          "id": "ts-pack-smoke",
          "argv": [
            "bash",
            "scripts/verify-ts-pack.sh"
          ]
        },
        {
          "id": "py-build-smoke",
          "argv": [
            "bash",
            "scripts/verify-python-build.sh"
          ]
        },
        {
          "id": "cdk-ts-pack-smoke",
          "argv": [
            "bash",
            "scripts/verify-cdk-ts-pack.sh"
          ]
        }
      ]
    }
  }
}
