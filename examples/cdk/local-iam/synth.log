  CallerNode65719A41:
    Type: AWS::Lambda::Function
    Properties:
      Code:
        ZipFile: |
          // The Node caller's entry point.
          //
          // The nodejs24.x image carries the AWS SDK for JavaScript v3 under
          // /var/runtime/node_modules, which is not on a /var/task module's resolution
          // path; the SDK is required by its absolute path.

          "use strict";

          const { createHash } = require("node:crypto");
          const { request: httpRequest } = require("node:http");

          // The nodejs24.x image ships the AWS SDK for JavaScript v3 under
          // /var/runtime/node_modules, which is not on a /var/task module's resolution
          // path, so the SDK is required by its absolute path.
          const SDK = "/var/runtime/node_modules/";
          const { SignatureV4 } = require(SDK + "@aws-sdk/signature-v4");
          const { HttpRequest } = require(SDK + "@aws-sdk/protocol-http");
          const { STSClient, AssumeRoleCommand } = require(SDK + "@aws-sdk/client-sts");

          const EMPTY_HASH = createHash("sha256").update("").digest("hex");

          function credentialsFromEnvironment() {
            const accessKeyId = process.env.AWS_ACCESS_KEY_ID || "";
            const secretAccessKey = process.env.AWS_SECRET_ACCESS_KEY || "";
            const sessionToken = process.env.AWS_SESSION_TOKEN || "";
            if (!accessKeyId || !secretAccessKey) {
              throw new Error("the container has no AWS credentials");
            }
            return { accessKeyId, secretAccessKey, sessionToken };
          }

          async function assumeRole(roleArn, sessionName) {
            const client = new STSClient({ region: "us-east-1" });
            const response = await client.send(
              new AssumeRoleCommand({ RoleArn: roleArn, RoleSessionName: sessionName }),
            );
            return {
              accessKeyId: response.Credentials.AccessKeyId,
              secretAccessKey: response.Credentials.SecretAccessKey,
              sessionToken: response.Credentials.SessionToken,
              principalArn: response.AssumedRoleUser.Arn,
            };
          }

          function proxy(payload) {
            return {
              statusCode: 200,
              headers: { "content-type": "application/json" },
              body: JSON.stringify(payload),
            };
          }

          function echoIdentity(event) {
            const context = (event && event.requestContext) || {};
            const identity = context.identity || {};
            const iam = (context.authorizer && context.authorizer.iam) || {};
            const route = context.routeKey || context.httpMethod || "function-url";
            return proxy({
              route,
              caller: identity.caller || iam.callerId || null,
              userArn: identity.userArn || iam.userArn || null,
              accountId: identity.accountId || iam.accountId || null,
              accessKey: identity.accessKey || iam.accessKey || null,
            });
          }

          // sendRequest issues the signed request with node:http, which is the transport
          // the SDK's own Node handler uses.
          function sendRequest(url, method, headers) {
            return new Promise((resolve, reject) => {
              const outgoing = httpRequest(
                {
                  hostname: url.hostname,
                  port: url.port || 80,
                  path: url.pathname + url.search,
                  method,
                  headers,
                },
                (response) => {
                  const chunks = [];
                  response.on("data", (chunk) => chunks.push(chunk));
                  response.on("end", () =>
                    resolve({ status: response.statusCode || 0, body: Buffer.concat(chunks).toString("utf8") }),
                  );
                },
              );
              outgoing.on("error", reject);
              outgoing.end();
            });
          }

          async function handler(event) {
            const role = process.env.APPTHEORY_LOCAL_IAM_ROLE || "";
            if (!role) {
              return echoIdentity(event);
            }
            const outcome = { role, signed: false };
            try {
              let credentials = credentialsFromEnvironment();
              outcome.accessKeyId = credentials.accessKeyId;
              if (event.assumeRoleArn) {
                const assumed = await assumeRole(
                  event.assumeRoleArn,
                  event.roleSessionName || "local-iam-row",
                );
                credentials = {
                  accessKeyId: assumed.accessKeyId,
                  secretAccessKey: assumed.secretAccessKey,
                  sessionToken: assumed.sessionToken,
                };
                outcome.accessKeyId = assumed.accessKeyId;
                outcome.principalArn = assumed.principalArn;
              }
              const url = new URL(event.url);
              const request = new HttpRequest({
                method: event.method || "GET",
                protocol: url.protocol,
                hostname: url.hostname,
                port: url.port ? Number(url.port) : undefined,
                path: url.pathname,
                query: Object.fromEntries(url.searchParams.entries()),
                headers: { host: url.host },
              });
              if (event.unsigned !== true) {
                const signer = new SignatureV4({
                  credentials,
                  region: "us-east-1",
                  service: "execute-api",
                  sha256: (value) => createHash("sha256").update(value).digest(),
                });
                const signed = await signer.sign(request);
                request.headers = signed.headers;
                outcome.signed = true;
                if (event.tamperSignature === true) {
                  const authorization = request.headers.authorization || "";
                  const index = authorization.lastIndexOf("Signature=");
                  if (index >= 0) {
                    const prefix = authorization.slice(0, index + "Signature=".length);
                    const signature = authorization.slice(index + "Signature=".length);
                    const last = signature.slice(-1) === "0" ? "1" : "0";
                    request.headers.authorization = prefix + signature.slice(0, -1) + last;
                  }
                }
              }
              const answer = await sendRequest(url, request.method, request.headers);
              outcome.status = answer.status;
              outcome.body = answer.body;
              return proxy(outcome);
            } catch (error) {
              outcome.status = 403;
              outcome.body = String(error && error.message ? error.message : error);
              return proxy(outcome);
            }
          }

          module.exports = { handler, EMPTY_HASH };
      Description: "Node caller: signs an execute-api call with the AWS SDK for JavaScript v3"
      Environment:
        Variables:
          APPTHEORY_LOCAL_IAM_ROLE: caller-node
          NODE_PATH: /var/runtime/node_modules
      Handler: index.handler
      Role:
        Fn::GetAtt:
          - CallerRole7E4BBD59
          - Arn
      Runtime: nodejs24.x
      Timeout: 30
    DependsOn:
