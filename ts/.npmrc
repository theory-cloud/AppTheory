# TableTheory is an integrity-pinned GitHub Release tarball declared directly
# by this package. npm 12 denies remote dependencies by default; permit only
# root declarations so transitive packages cannot introduce remote fetches.
allow-remote=root

# R-G3: lifecycle scripts stay disabled structurally for every install in this
# directory, so a compromised dependency's install hooks cannot run in CI, the
# rubric, or gov-infra. scripts/verify-npm-install-hygiene.sh fails closed when
# a lockfile directory is missing this config or turns scripts back on.
ignore-scripts=true
