{
  "name": "@theory-cloud/apptheory",
  "version": "4.3.0",
  "description": "AppTheory — multi-language serverless application framework (TypeScript package)",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run check && node ./scripts/verify-openapi.mjs && node ./scripts/verify-secure-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 --report-unused-disable-directives \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1134.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1134.0",
    "@aws-sdk/client-lambda-microvms": "^3.1134.0",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/client-s3vectors": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@theory-cloud/tabletheory-ts": "https://github.com/theory-cloud/TableTheory/releases/download/v3.1.0/theory-cloud-tabletheory-ts-3.1.0.tgz#sha512-iK2Zn+aeyP9BnAFAUjq36G6G7ZlP1bulz04aIGCy6lRyOMkRihYZutiAkuABQlIwnGd0FqomrSw4nUvjx3dDYw=="
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
