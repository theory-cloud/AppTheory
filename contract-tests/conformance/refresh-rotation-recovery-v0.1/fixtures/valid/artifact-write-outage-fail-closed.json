{
  "contract": "theorycloud_refresh_rotation_recovery.v0.1",
  "case_id": "artifact-write-outage-fail-closed",
  "description": "The replay-artifact write is unavailable during a rotation. The consuming path fails closed 503 before minting (no unlinkable successor), the family stays intact, and the retry after the outage rotates atomically and succeeds.",
  "expected_outcome": "conformant",
  "stage_config": {
    "serve_window_seconds": 600,
    "access_token_ttl_seconds": 900,
    "refresh_due_fraction": 0.5,
    "sweep_interval_seconds": 60,
    "generation_bound": 4,
    "margin": 2.0
  },
  "scenario": [
    {
      "t_offset_seconds": 0,
      "actor": "steward-a",
      "action": "rotate",
      "generation": "g5",
      "successor": "g6",
      "minted": false,
      "wire": "temporarily_unavailable_503"
    },
    {
      "t_offset_seconds": 30,
      "actor": "steward-a",
      "action": "rotate",
      "generation": "g5",
      "successor": "g6",
      "minted": true,
      "artifact_atomic": true,
      "wire": "success"
    }
  ],
  "expect": {
    "family_revoked": false,
    "recovery": "none",
    "terminal_wire_error": "none",
    "transient_wire": "temporarily_unavailable_503",
    "receipt_emitted": false
  }
}
