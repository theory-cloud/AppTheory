{
  "contract": "theorycloud_refresh_rotation_recovery.v0.1",
  "case_id": "out-of-window-replay-revokes",
  "description": "Control case: the family rotated g7 -> g8, then g7 is presented beyond the serve window W. Out-of-window replay is an R5 revocation trigger: the family is revoked with a receipt and the presenter gets the genuinely terminal invalid_grant.",
  "expected_outcome": "conformant",
  "stage_config": {
    "serve_window_seconds": 600,
    "access_token_ttl_seconds": 900,
    "refresh_due_fraction": 0.5,
    "sweep_interval_seconds": 60,
    "generation_bound": 4,
    "margin": 2.0
  },
  "scenario": [
    {
      "t_offset_seconds": 0,
      "actor": "steward-a",
      "action": "rotate",
      "generation": "g7",
      "successor": "g8",
      "minted": true,
      "artifact_atomic": true,
      "wire": "success"
    },
    {
      "t_offset_seconds": 900,
      "actor": "stale-presenter",
      "action": "present",
      "generation": "g7",
      "in_window": false,
      "wire": "invalid_grant"
    },
    {
      "t_offset_seconds": 900,
      "actor": "autheory",
      "action": "revoke",
      "reason": "out_of_window_replay"
    }
  ],
  "expect": {
    "family_revoked": true,
    "recovery": "none",
    "terminal_wire_error": "invalid_grant",
    "transient_wire": "none",
    "receipt_emitted": true
  }
}
