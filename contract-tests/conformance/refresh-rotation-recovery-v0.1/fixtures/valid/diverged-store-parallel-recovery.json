{
  "contract": "theorycloud_refresh_rotation_recovery.v0.1",
  "case_id": "diverged-store-parallel-recovery",
  "description": "Two parallel sessions of one identity hold diverged stores. Steward A's rescue mints g4 with the artifact atomically; steward B still holds the consumed g3, presents it in-window, and is walk-served g4. Parallel sessions are never fork evidence.",
  "expected_outcome": "conformant",
  "stage_config": {
    "serve_window_seconds": 600,
    "access_token_ttl_seconds": 900,
    "refresh_due_fraction": 0.5,
    "sweep_interval_seconds": 60,
    "generation_bound": 4,
    "margin": 2.0
  },
  "scenario": [
    {
      "t_offset_seconds": 0,
      "actor": "steward-a",
      "action": "rescue_mint",
      "generation": "g3",
      "successor": "g4",
      "minted": true,
      "artifact_atomic": true,
      "wire": "success"
    },
    {
      "t_offset_seconds": 15,
      "actor": "steward-b",
      "action": "present",
      "generation": "g3",
      "in_window": true,
      "wire": "success",
      "recovery": "walk_serve"
    }
  ],
  "expect": {
    "family_revoked": false,
    "recovery": "walk_serve",
    "terminal_wire_error": "none",
    "transient_wire": "none",
    "receipt_emitted": false
  }
}
