{
  "contract": "theorycloud_refresh_rotation_recovery.v0.1",
  "case_id": "burst-budget-exhaustion-transient",
  "description": "A concurrent-presenter burst against the replaced g6 exceeds the walk budget. Excess presenters get transient replay_budget_exhausted 503s (never a revocation, never invalid_grant), and their retries are walk-served. The family stays intact throughout.",
  "expected_outcome": "conformant",
  "stage_config": {
    "serve_window_seconds": 600,
    "access_token_ttl_seconds": 900,
    "refresh_due_fraction": 0.5,
    "sweep_interval_seconds": 60,
    "generation_bound": 4,
    "margin": 2.0
  },
  "scenario": [
    {
      "t_offset_seconds": 0,
      "actor": "steward-a",
      "action": "rotate",
      "generation": "g6",
      "successor": "g7",
      "minted": true,
      "artifact_atomic": true,
      "wire": "success"
    },
    {
      "t_offset_seconds": 5,
      "actor": "steward-b",
      "action": "present",
      "generation": "g6",
      "in_window": true,
      "wire": "success",
      "recovery": "walk_serve"
    },
    {
      "t_offset_seconds": 5,
      "actor": "steward-c",
      "action": "present",
      "generation": "g6",
      "in_window": true,
      "wire": "replay_budget_exhausted_503"
    },
    {
      "t_offset_seconds": 5,
      "actor": "steward-d",
      "action": "present",
      "generation": "g6",
      "in_window": true,
      "wire": "replay_budget_exhausted_503"
    },
    {
      "t_offset_seconds": 65,
      "actor": "steward-c",
      "action": "present",
      "generation": "g6",
      "in_window": true,
      "wire": "success",
      "recovery": "walk_serve"
    },
    {
      "t_offset_seconds": 65,
      "actor": "steward-d",
      "action": "present",
      "generation": "g6",
      "in_window": true,
      "wire": "success",
      "recovery": "walk_serve"
    }
  ],
  "expect": {
    "family_revoked": false,
    "recovery": "walk_serve",
    "terminal_wire_error": "none",
    "transient_wire": "replay_budget_exhausted_503",
    "receipt_emitted": false
  }
}
