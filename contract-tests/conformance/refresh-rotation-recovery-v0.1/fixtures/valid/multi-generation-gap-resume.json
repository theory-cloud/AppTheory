    "margin": 2.0
  },
  "scenario": [
    {
      "t_offset_seconds": 0,
      "actor": "family",
      "action": "advance",
      "generation": "g0",
      "successor": "g12",
      "hops": 12
    },
    {
      "t_offset_seconds": 540,
      "actor": "steward-a",
      "action": "present",
      "generation": "g0",
      "in_window": true,
      "wire": "success",
      "recovery": "walk_serve"
