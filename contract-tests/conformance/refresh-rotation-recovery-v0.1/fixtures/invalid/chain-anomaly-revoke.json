    "margin": 2.0
  },
  "scenario": [
    {
      "t_offset_seconds": 0,
      "actor": "steward-a",
      "action": "present",
      "generation": "g5",
      "in_window": true,
      "wire": "temporarily_unavailable_503"
    },
    {
      "t_offset_seconds": 1,
      "actor": "autheory",
      "action": "revoke",
      "reason": "chain_anomaly"
    }
  ],
  "expect": {
