{
  "id": "p1.request_id.shape_malformed_nonascii",
  "tier": "p1",
  "name": "A non-ASCII client x-request-id is ignored instead of becoming the request ID",
  "setup": {
    "request_id_source": "default",
    "routes": [
      {
        "method": "GET",
        "path": "/context",
        "handler": "echo_request_ids"
      }
    ]
  },
  "input": {
    "request": {
      "method": "GET",
      "path": "/context",
      "query": {},
      "headers": {
        "x-request-id": [
          "café"
        ]
      },
      "body": {
        "encoding": "utf8",
        "value": ""
      },
      "is_base64": false
    }
  },
  "expect": {
    "response": {
      "status": 200,
      "headers": {
        "content-type": [
          "application/json; charset=utf-8"
        ],
        "x-request-id": [
          "req_test_123"
        ]
      },
      "cookies": [],
      "body_json": {
        "request_id": "req_test_123",
        "client_request_id": ""
      },
      "is_base64": false
    }
  }
}
