{
  "id": "mcp.stateless.request_flow",
  "tier": "mcp",
  "name": "MCP 2026-07-28 requests and responses flow without initialize or sessions",
  "setup": {
    "mcp": {
      "server": {
        "name": "ContractMCP",
        "version": "sp09"
      },
      "tools": [
        {
          "name": "echo",
          "description": "Echo text",
          "input_schema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          },
          "handler": "echo_text"
        }
      ]
    }
  },
  "input": {
    "mcp": {
      "steps": [
        {
          "name": "tools_list_without_initialize",
          "request": {
            "method": "POST",
            "path": "/mcp",
            "headers": {
              "content-type": [
                "application/json"
              ],
              "accept": [
                "application/json, text/event-stream"
              ],
              "mcp-protocol-version": [
                "2026-07-28"
              ]
            },
            "body": {
              "encoding": "utf8",
              "value": "{\"jsonrpc\":\"2.0\",\"id\":\"list\",\"method\":\"tools/list\"}"
            },
            "is_base64": false
          }
        },
        {
          "name": "tools_call_without_session",
          "request": {
            "method": "POST",
            "path": "/mcp",
            "headers": {
              "content-type": [
                "application/json"
              ],
              "accept": [
                "application/json, text/event-stream"
              ]
            },
            "body": {
              "encoding": "utf8",
              "value": "{\"jsonrpc\":\"2.0\",\"id\":\"call\",\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"message\":\"stateless contract\"},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}}"
            },
            "is_base64": false
          }
        },
        {
          "name": "jsonrpc_response_without_session",
          "request": {
            "method": "POST",
            "path": "/mcp",
            "headers": {
              "content-type": [
                "application/json"
              ],
              "accept": [
                "application/json, text/event-stream"
              ],
              "mcp-protocol-version": [
                "2026-07-28"
              ]
            },
            "body": {
              "encoding": "utf8",
              "value": "{\"jsonrpc\":\"2.0\",\"id\":\"client-response\",\"result\":{\"ok\":true}}"
            },
            "is_base64": false
          }
        }
      ]
    }
  },
  "expect": {
    "mcp": {
      "steps": [
        {
          "status": 200,
          "headers": {
            "content-type": [
              "application/json"
            ],
            "x-request-id": [
              "req_mcp_123"
            ]
          },
          "cookies": [],
          "body_json": {
            "jsonrpc": "2.0",
            "id": "list",
            "result": {
              "tools": [
                {
                  "name": "echo",
                  "description": "Echo text",
                  "inputSchema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "message"
                    ]
                  }
                }
              ]
            }
          },
          "is_base64": false
        },
        {
          "status": 200,
          "headers": {
            "content-type": [
              "application/json"
            ],
            "x-request-id": [
              "req_mcp_123"
            ]
          },
          "cookies": [],
          "body_json": {
            "jsonrpc": "2.0",
            "id": "call",
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "stateless contract"
                }
              ]
            }
          },
          "is_base64": false
        },
        {
          "status": 202,
          "headers": {
            "x-request-id": [
              "req_mcp_123"
            ]
          },
          "cookies": [],
          "is_base64": false
        }
      ]
    }
  }
}
