{
  "id": "mcp.stateless.meta_negotiation",
  "tier": "mcp",
  "name": "MCP 2026-07-28 request metadata cannot replace the required HTTP protocol header",
  "setup": {
    "mcp": {
      "server": {
        "name": "ContractMCP",
        "version": "sp09"
      }
    }
  },
  "input": {
    "mcp": {
      "steps": [
        {
          "name": "request_metadata_without_http_header",
          "request": {
            "method": "POST",
            "path": "/mcp",
            "headers": {
              "content-type": [
                "application/json"
              ],
              "accept": [
                "application/json, text/event-stream"
              ],
              "mcp-method": [
                "ping"
              ]
            },
            "body": {
              "encoding": "utf8",
              "value": "{\"jsonrpc\":\"2.0\",\"id\":\"meta-ping\",\"method\":\"ping\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}"
            },
            "is_base64": false
          }
        }
      ]
    }
  },
  "expect": {
    "mcp": {
      "steps": [
        {
          "status": 400,
          "headers": {
            "content-type": [
              "application/json"
            ],
            "x-request-id": [
              "req_mcp_123"
            ]
          },
          "cookies": [],
          "body_json": {
            "jsonrpc": "2.0",
            "id": "meta-ping",
            "error": {
              "code": -32020,
              "message": "Header mismatch: missing required MCP-Protocol-Version header"
            }
          },
          "is_base64": false
        }
      ]
    }
  }
}
