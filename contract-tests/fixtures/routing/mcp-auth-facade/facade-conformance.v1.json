      "body": "x=y",
      "expect_error": "invalid_request"
    },
    {
      "id": "form_parse.blank_grant_type",
      "group": "form_parse",
      "body": "grant_type=",
      "expect_error": "invalid_request"
    },
    {
      "id": "form_parse.semicolon_separator_rejected",
      "group": "form_parse",
      "body": "grant_type=refresh_token;x=1",
      "expect_error": "invalid_request"
    },
    {
      "id": "form_parse.malformed_escape_rejected",
      "group": "form_parse",
      "body": "%zz=1&grant_type=refresh_token",
      "expect_error": "invalid_request"
    },
    {
      "id": "form_parse.client_credentials_unsupported",
      "group": "form_parse",
      "body": "grant_type=client_credentials",
      "expect_error": "unsupported_grant_type"
    },
    {
      "id": "form_parse.refresh_token_unsupported",
      "group": "form_parse",
      "body": "grant_type=refresh_token",
      "expect_error": "unsupported_grant_type"
    },
    {
      "id": "form_parse.repeated_grant_type_first_occurrence_wins",
      "group": "form_parse",
      "body": "grant_type=refresh_token&grant_type=authorization_code",
