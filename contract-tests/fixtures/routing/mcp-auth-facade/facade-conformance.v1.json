    },
    {
      "id": "redirect_match.different_path_rejected",
      "group": "redirect_match",
      "registered": ["http://127.0.0.1/cb"],
      "requested": "http://127.0.0.1/other",
      "expect": "reject"
    },
    {
      "id": "redirect_match.scheme_downgrade_rejected",
      "group": "redirect_match",
      "registered": ["https://127.0.0.1/cb"],
      "requested": "http://127.0.0.1/cb",
      "expect": "reject"
    },
    {
      "id": "redirect_match.query_mismatch_rejected",
      "group": "redirect_match",
      "registered": ["http://127.0.0.1/cb?tenant=a"],
      "requested": "http://127.0.0.1/cb?tenant=b",
      "expect": "reject"
    },
    {
      "id": "redirect_match.fragment_mismatch_rejected",
      "group": "redirect_match",
      "registered": ["http://127.0.0.1/cb#a"],
      "requested": "http://127.0.0.1/cb#b",
      "expect": "reject"
    },
    {
      "id": "redirect_match.non_loopback_different_path_rejected",
      "group": "redirect_match",
      "registered": ["https://client.example/callback"],
      "requested": "https://client.example/other",
      "expect": "reject"
    },
    {
      "id": "redirect_match.unregistered_requested_rejected",
      "group": "redirect_match",
      "registered": ["https://client.example/callback"],
      "requested": "https://other.example/callback",
