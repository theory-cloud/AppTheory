      "group": "redirect_match",
      "registered": ["http://127.0.0.1/cb"],
      "requested": "http://127.0.0.1:12345/cb",
      "expect": "accept"
    },
    {
      "id": "redirect_match.registered_with_port_requested_portless",
      "group": "redirect_match",
      "registered": ["http://127.0.0.1:12345/cb"],
      "requested": "http://127.0.0.1/cb",
      "expect": "accept"
    },
    {
      "id": "redirect_match.differing_loopback_ports",
      "group": "redirect_match",
      "registered": ["http://127.0.0.1:12345/cb"],
      "requested": "http://127.0.0.1:9999/cb",
