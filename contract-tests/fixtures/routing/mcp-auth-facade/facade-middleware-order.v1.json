    {"id": "middleware_order.secure.pass_through_writer.invalid", "group": "middleware_order", "surface": "secure", "tier": "p0", "methods": ["POST", "GET", "DELETE"], "credential": "invalid", "middleware": "pass_through_writer", "policy": "none", "expect": {"status": 401, "order": ["bearer"], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 0, "www_authenticate": "Bearer resource_metadata=\"https://front.example.com/.well-known/oauth-protected-resource/acme/mcp\""}},
    {"id": "middleware_order.secure.pass_through_writer.valid", "group": "middleware_order", "surface": "secure", "tier": "p0", "methods": ["POST", "GET", "DELETE"], "credential": "valid", "middleware": "pass_through_writer", "policy": "none", "expect": {"status": 204, "order": ["bearer", "middleware", "handler"], "middleware_invocations": 1, "cache_lookups": 0, "middleware_writes": 1, "handler_invocations": 1, "policy_hook_invocations": 0}},
    {"id": "middleware_order.secure.policy_allow.missing", "group": "middleware_order", "surface": "secure", "tier": "p2", "methods": ["POST", "GET", "DELETE"], "credential": "missing", "middleware": "pass_through_writer", "policy": "allow", "expect": {"status": 401, "order": ["policy"], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 1, "www_authenticate": "Bearer resource_metadata=\"https://front.example.com/.well-known/oauth-protected-resource/acme/mcp\""}},
    {"id": "middleware_order.secure.policy_allow.invalid", "group": "middleware_order", "surface": "secure", "tier": "p2", "methods": ["POST", "GET", "DELETE"], "credential": "invalid", "middleware": "pass_through_writer", "policy": "allow", "expect": {"status": 401, "order": ["policy", "bearer"], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 1, "www_authenticate": "Bearer resource_metadata=\"https://front.example.com/.well-known/oauth-protected-resource/acme/mcp\""}},
    {"id": "middleware_order.secure.policy_allow.valid", "group": "middleware_order", "surface": "secure", "tier": "p2", "methods": ["POST", "GET", "DELETE"], "credential": "valid", "middleware": "pass_through_writer", "policy": "allow", "expect": {"status": 204, "order": ["policy", "bearer", "middleware", "handler"], "middleware_invocations": 1, "cache_lookups": 0, "middleware_writes": 1, "handler_invocations": 1, "policy_hook_invocations": 1}},
    {"id": "middleware_order.secure.policy_deny.valid", "group": "middleware_order", "surface": "secure", "tier": "p2", "methods": ["POST", "GET", "DELETE"], "credential": "valid", "middleware": "short_circuit_cache", "policy": "deny", "expect": {"status": 429, "order": ["policy"], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 1}}
