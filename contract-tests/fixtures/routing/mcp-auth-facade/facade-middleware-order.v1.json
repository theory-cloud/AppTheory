{
  "contract": {
    "id": "m17.mcp-middleware-order/v1",
    "status": "registered (security M1)",
    "notes": "Pins the runtime-bearer ordering contract for the MCP transport routes: the route-level bearer guard runs before application middleware, so a short-circuiting cache or a write-performing pass-through middleware cannot observe or serve a credential-free request. The same rows drive the Go, TypeScript, and Python loaders. Policy rows pin that the pre-authorization PolicyHook keeps running before the bearer guard."
  },
  "mount": {
    "issuer_url": "https://issuer.example.com/",
    "jwks_uri": "https://issuer.example.com/jwks.json?set=active",
    "public_base_url": "https://front.example.com/",
    "client_namespace": "acme",
    "resource_metadata_url": "https://front.example.com/.well-known/oauth-protected-resource/acme/mcp",
    "valid_token": "valid-token",
    "invalid_token": "invalid-token",
    "subject": "acme",
    "audience": "https://front.example.com",
    "scopes": {
      "namespace": ["namespace:use"],
      "partner_namespace": ["partner_namespace:use"],
      "agent": ["agent:use"],
      "partner_agent": ["partner_agent:use"]
    }
  },
  "cases": [
    {"id": "middleware_order.plain.short_circuit_cache.missing", "group": "middleware_order", "surface": "plain", "tier": "p0", "methods": ["POST", "GET", "DELETE"], "credential": "missing", "middleware": "short_circuit_cache", "policy": "none", "expect": {"status": 401, "order": [], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 0, "www_authenticate": "Bearer resource_metadata=\"https://front.example.com/.well-known/oauth-protected-resource/acme/mcp\""}},
    {"id": "middleware_order.plain.short_circuit_cache.invalid", "group": "middleware_order", "surface": "plain", "tier": "p0", "methods": ["POST", "GET", "DELETE"], "credential": "invalid", "middleware": "short_circuit_cache", "policy": "none", "expect": {"status": 401, "order": ["bearer"], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 0, "www_authenticate": "Bearer resource_metadata=\"https://front.example.com/.well-known/oauth-protected-resource/acme/mcp\""}},
    {"id": "middleware_order.plain.short_circuit_cache.valid", "group": "middleware_order", "surface": "plain", "tier": "p0", "methods": ["POST", "GET", "DELETE"], "credential": "valid", "middleware": "short_circuit_cache", "policy": "none", "expect": {"status": 200, "order": ["bearer", "middleware"], "middleware_invocations": 1, "cache_lookups": 1, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 0, "body": "cached-protected"}},
    {"id": "middleware_order.plain.pass_through_writer.missing", "group": "middleware_order", "surface": "plain", "tier": "p0", "methods": ["POST", "GET", "DELETE"], "credential": "missing", "middleware": "pass_through_writer", "policy": "none", "expect": {"status": 401, "order": [], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 0, "www_authenticate": "Bearer resource_metadata=\"https://front.example.com/.well-known/oauth-protected-resource/acme/mcp\""}},
    {"id": "middleware_order.plain.pass_through_writer.invalid", "group": "middleware_order", "surface": "plain", "tier": "p0", "methods": ["POST", "GET", "DELETE"], "credential": "invalid", "middleware": "pass_through_writer", "policy": "none", "expect": {"status": 401, "order": ["bearer"], "middleware_invocations": 0, "cache_lookups": 0, "middleware_writes": 0, "handler_invocations": 0, "policy_hook_invocations": 0, "www_authenticate": "Bearer resource_metadata=\"https://front.example.com/.well-known/oauth-protected-resource/acme/mcp\""}},
