{
  "contract": {
    "id": "m17.mcp-auth-facade/v1",
    "section": "store-spi",
    "kind": "conformance",
    "status": "M2",
    "notes": "One conformance table for the five store SPIs of DESIGN §7. Every store (the framework's in-memory reference stores now, an application's durable store later) must pass every row. The rows are executed by the runtime loader tests in Go, TypeScript and Python against the in-memory reference stores; the same rows and outcomes must hold in all three. Scenario names dispatch to each runtime's store methods; `expect` carries the observable outcome. Consume-once and compare-and-swap are required atomic operations, not conventions. The broker lock TTL those rows measure is the framework-mandated 15 seconds (oauthstore.DefaultRouteRefreshLockTTL, TS DEFAULT_ROUTE_REFRESH_LOCK_TTL_SECONDS, py UTC_NOW_LOCK_TTL_SECONDS): the M2.1 hardened upstream HTTP deadline plus a five-second margin, and each runtime's suite pins the table's lock_ttl_seconds to that default so a conforming durable store is judged against the mandated value. The `family_*` rows execute the mandatory transactional family capability: atomic root creation, atomic rotation, tombstone-honoring read/lock/rotate, fail-closed legacy and partially backfilled lineages, both rotation/revocation linearization orders, revocation of families past the removed eight-link budget and past one DynamoDB transaction's 100-action cap, idempotent terminal revocation, and listed-versus-aged-out enumeration. A family-marked handle's Get, AcquireLock, and RotateFamily honor the family tombstone; ListFamily remains the incident surface and lists live members even when family state is missing."
  },
  "clock": {
    "epoch": "2026-01-01T00:00:00Z",
    "notes": "Stores take an injectable clock; every row starts at this instant."
  },
  "ttl_seconds": {
    "transaction_max": 600,
    "authorization_code_max": 600,
    "authorization_code_recommended": 60,
    "route_refresh_broker": 900,
    "rate_limit_window": 60
  },
  "outcomes": {
    "ok": "the operation succeeded",
    "not_found": "no record for the key (unknown key)",
    "replayed": "the record was already consumed (distinguishable from not_found)",
    "expired": "the record existed but its TTL elapsed",
    "locked": "the broker record already holds an unexpired refresh lock",
    "revoked": "the broker record or its family is revoked; it cannot be refreshed or locked",
    "version_conflict": "compare-and-swap failed: the caller's version is stale",
    "family_exists": "the family ID already exists (active or revoked); it is never overwritten or reactivated",
    "family_state_unavailable": "a family-marked record has no usable family state; every read, lock, rotation, and revocation fails closed",
    "family_mismatch": "a root, successor, or presented record does not carry the required family/generation binding",
    "successor_exists": "the rotation successor handle is already stored; a rotation never overwrites a handle",
    "legacy_lineage_unsupported": "a family-less record was presented for ordinary rotation; the lineage is migration or reauthorization, never online normalization",
    "allowed": "the rate-limit check is within the window budget",
    "limited": "the rate-limit check exceeded the window budget"
  },
