{
  "contract": {
    "id": "m17.mcp-auth-facade/route-challenge/v1",
    "status": "registered (M2)",
    "notes": "Pins the route-derived RFC 9728 / RFC 6750 denial surface: a credential-free or invalid request returns 401 with the WWW-Authenticate challenge for the exact matched route's protected-resource metadata URL, a scope failure returns 403 insufficient_scope carrying the remediation scope set from the route scope map, and every other forbidden denial (for example an audience mismatch) advertises neither an error code nor a scope set. Loaded directly by the Go, TypeScript, and Python tests."
  },
  "challenge": {
    "missing_token": {
      "status": 401,
      "www_authenticate": "Bearer resource_metadata=\"<route protected-resource metadata URL>\"",
      "handler_invocations": 0
    },
    "invalid_token": {
      "status": 401,
      "www_authenticate": "Bearer resource_metadata=\"<route protected-resource metadata URL>\"",
      "handler_invocations": 0
    },
    "expired_token": {
      "status": 401,
      "www_authenticate": "Bearer resource_metadata=\"<route protected-resource metadata URL>\"",
      "handler_invocations": 0
    },
    "insufficient_scope": {
      "status": 403,
      "www_authenticate": "Bearer error=\"insufficient_scope\", scope=\"<space-joined remediation scopes>\", resource_metadata=\"<route protected-resource metadata URL>\"",
      "body_error_code": "app.insufficient_scope",
      "handler_invocations": 0
    },
    "invalid_audience": {
      "status": 403,
      "www_authenticate": null,
      "body_error_code": "app.forbidden",
      "handler_invocations": 0
    }
  },
  "route_derived": {
    "per_route": true,
    "example": {
      "route": "/acme/mcp",
      "resource": "https://mcp.example.com/acme/mcp",
      "resource_metadata_url": "https://mcp.example.com/.well-known/oauth-protected-resource/acme/mcp",
      "challenge": "Bearer resource_metadata=\"https://mcp.example.com/.well-known/oauth-protected-resource/acme/mcp\""
    },
    "note": "The challenge's resource_metadata is the matched route's metadata URL, never a process-global value."
  },
  "resource_indicator": {
    "rule": "RFC 8707 resource is canonicalized and must exactly equal the route resource; any other value is refused",
    "accept": [
      {
        "route_resource": "https://mcp.example.com/acme/mcp",
        "requested": "https://mcp.example.com/acme/mcp",
        "match": true
      },
      {
        "route_resource": "https://mcp.example.com/acme/mcp",
        "requested": "https://mcp.example.com/acme/mcp/",
        "match": true
      }
    ],
    "reject": [
      { "route_resource": "https://mcp.example.com/acme/mcp", "requested": "https://mcp.example.com/other/mcp" },
      { "route_resource": "https://mcp.example.com/acme/mcp", "requested": "https://mcp.example.com/acme/mcp/extra" },
      { "route_resource": "https://mcp.example.com/acme/mcp", "requested": "https://evil.example.com/acme/mcp" },
      { "route_resource": "https://mcp.example.com/acme/mcp", "requested": "" }
    ]
  },
  "resource_metadata_template": {
    "notes": "The bearer middleware accepts an absolute HTTPS `{param}` template (`ResourceMetadataURLTemplate` / `resourceMetadataURLTemplate` / `resource_metadata_url_template`). Compilation happens once, at registration, and refuses a template that is not an absolute HTTPS URL free of userinfo, query, fragment, or percent-escape, or whose placeholders do not sit in the path and do not name route parameters. At request time every placeholder is interpolated from the matched route's path parameters, and a placeholder the route does not supply, or a value outside the pinned alphabet, fails closed to the bare `Bearer` challenge, so a literal placeholder is never advertised. Precedence is ResourceMetadataURLFunc > ResourceMetadataURLTemplate > ResourceMetadataURL.",
    "value_rule": "A substituted route-parameter value must be 1..128 bytes of [a-z0-9._~-] and must not be \".\" or \"..\". Empty, `/`-containing, percent-encoded, upper-case, whitespace, control, backslash, and non-ASCII values are refused.",
    "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}",
    "accept": [
      {
        "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}",
        "params": { "actor": "alpha" },
        "expect_url": "https://api.example.com/.well-known/oauth-protected-resource/mcp/alpha"
      },
      {
        "template": "https://api.example.com/.well-known/oauth-protected-resource/{client_namespace}/agents/{agent_id}/mcp",
        "params": { "client_namespace": "acme", "agent_id": "agent-7" },
        "expect_url": "https://api.example.com/.well-known/oauth-protected-resource/acme/agents/agent-7/mcp"
      },
      {
        "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp",
        "params": {},
        "expect_url": "https://api.example.com/.well-known/oauth-protected-resource/mcp"
      },
      {
        "template": "  https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}  ",
        "params": { "actor": "alpha.beta_1~x" },
        "expect_url": "https://api.example.com/.well-known/oauth-protected-resource/mcp/alpha.beta_1~x"
      }
    ],
    "refused_template": [
      { "template": "http://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}" },
      { "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}?tenant=acme" },
      { "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}#frag" },
      { "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{Actor}" },
      { "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{}/mcp" },
      { "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor" },
      { "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/actor}" },
      { "template": "https://user@api.example.com/.well-known/oauth-protected-resource/mcp/{actor}" },
      { "template": "https://{actor}.example.com/.well-known/oauth-protected-resource/mcp" },
      { "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp%2F{actor}" }
    ],
    "refused_value": [
      { "params": { "actor": "" } },
      { "params": { "actor": "." } },
      { "params": { "actor": ".." } },
      { "params": { "actor": "alpha/beta" } },
      { "params": { "actor": "alpha%2Fbeta" } },
      { "params": { "actor": "Alpha" } },
      { "params": { "actor": "alpha beta" } },
      { "params": { "actor": "alpha\tbeta" } },
      { "params": { "actor": "alpha\\beta" } },
      { "params": { "actor": "alpha\u0000beta" } },
      { "params": { "actor": "alphä" } },
      { "params": { "actor": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }
    ],
    "missing_param": [
      { "params": {} },
      { "params": { "namespace": "acme" } }
    ],
    "precedence": {
      "notes": "A route-derived resolver wins over the template, and the template wins over the static URL.",
      "func_wins": {
        "resource_metadata_url_func": "https://func.example.com/.well-known/oauth-protected-resource/mcp/alpha",
        "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}",
        "resource_metadata_url": "https://static.example.com/.well-known/oauth-protected-resource/mcp",
        "params": { "actor": "alpha" },
        "expect_url": "https://func.example.com/.well-known/oauth-protected-resource/mcp/alpha"
      },
      "template_wins": {
        "template": "https://api.example.com/.well-known/oauth-protected-resource/mcp/{actor}",
        "resource_metadata_url": "https://static.example.com/.well-known/oauth-protected-resource/mcp",
        "params": { "actor": "alpha" },
        "expect_url": "https://api.example.com/.well-known/oauth-protected-resource/mcp/alpha"
      }
    }
  }
}
