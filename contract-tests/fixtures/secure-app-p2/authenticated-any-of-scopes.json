          "method": "GET",
          "path": "/statuses",
          "handler": "secure_echo",
          "posture": "authenticated_any_of",
          "scopes": [
            " read:statuses ",
            "read",
            "read:statuses",
            " "
          ]
        }
      ]
    }
  },
