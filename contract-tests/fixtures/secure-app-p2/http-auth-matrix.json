          "path": "/authenticated",
          "handler": "secure_echo",
          "posture": "authenticated"
        },
        {
          "surface": "http",
          "method": "GET",
          "path": "/scoped",
          "handler": "secure_echo",
          "posture": "authenticated",
          "scopes": [
            " read ",
            "write",
            "read"
          ]
        },
        {
          "surface": "http",
          "method": "POST",
          "path": "/internal",
          "handler": "secure_echo",
          "posture": "internal_only"
        },
        {
          "surface": "http",
          "method": "GET",
          "path": "files/:path+?ignored=true",
          "handler": "secure_mutate_principal",
          "posture": "authenticated"
        }
      ]
    }
  },
