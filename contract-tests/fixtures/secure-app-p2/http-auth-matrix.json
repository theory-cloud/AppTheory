{
  "id": "p2.secure_http_auth_matrix",
  "tier": "p2",
  "name": "secure HTTP postures classify principals and enforce all scopes before middleware",
  "setup": {
    "secure_app": {
      "tier": "p2",
      "middlewares": [
        "record"
      ],
      "routes": [
        {
          "surface": "http",
          "method": "GET",
          "path": "/public",
          "handler": "secure_echo",
          "posture": "public"
        },
        {
          "surface": "http",
          "method": "GET",
          "path": "/optional",
          "handler": "secure_echo",
          "posture": "optional"
        },
        {
          "surface": "http",
