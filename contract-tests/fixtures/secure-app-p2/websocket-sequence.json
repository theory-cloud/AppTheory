        "status": 403,
        "error_code": "app.forbidden",
        "resolver_calls": 1,
        "middleware_calls": 0,
        "handler_calls": 0
      },
      {
        "name": "internal-success",
        "status": 200,
        "principal": {
          "identity": "svc",
          "kind": "internal",
          "scopes": [],
          "claims": {}
        },
        "resolver_calls": 1,
        "middleware_calls": 1,
        "handler_calls": 1
      },
      {
        "name": "resolver-error",
        "status": 409,
        "error_code": "app.conflict",
        "resolver_calls": 1,
        "middleware_calls": 0,
        "handler_calls": 0
      },
      {
        "name": "internal-denied",
        "status": 403,
        "error_code": "app.forbidden",
        "resolver_calls": 1,
        "middleware_calls": 0,
        "handler_calls": 0
      },
      {
        "name": "revoked",
        "status": 401,
        "error_code": "app.unauthorized",
        "resolver_calls": 1,
        "middleware_calls": 0,
        "handler_calls": 0
      },
      {
        "name": "disconnect-public",
        "status": 200,
        "resolver_calls": 0,
        "middleware_calls": 1,
        "handler_calls": 1
      },
      {
        "name": "routes",
        "routes": [
          {
            "surface": "websocket",
            "posture": "optional",
            "websocket_route_key": "$connect"
          },
          {
            "surface": "websocket",
            "posture": "authenticated",
            "scopes": [
              "messages:write"
            ],
            "websocket_route_key": "sendMessage"
          },
          {
            "surface": "websocket",
            "posture": "internal_only",
            "websocket_route_key": "internal"
          },
          {
            "surface": "websocket",
            "posture": "public",
            "websocket_route_key": "$disconnect"
