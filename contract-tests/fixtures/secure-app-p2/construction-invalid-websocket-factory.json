{
  "id": "p2.secure_construction_invalid_websocket_factory",
  "tier": "p2",
  "name": "secure construction rejects an invalid websocket factory independently",
  "setup": {
    "secure_app": {
      "tier": "p2",
      "invalid_websocket_factory": true
    }
  },
  "input": {
    "secure_steps": [
      {
        "name": "invalid-websocket-factory",
        "operation": "construct"
      }
    ]
  },
  "expect": {
    "secure_steps": [
      {
        "name": "invalid-websocket-factory",
        "construction_error": "apptheory: invalid secure configuration"
      }
    ]
  }
}
