{
  "id": "p2.secure_posture_record_fail_closed",
  "tier": "p2",
  "name": "matched secure routes with missing or invalid posture records fail closed",
  "setup": {
    "secure_app": {
      "tier": "p2",
      "inject_posture_records": true,
      "routes": [
        {
          "surface": "http",
          "method": "GET",
          "path": "/missing-record",
          "handler": "secure_echo",
          "posture": "missing"
        },
        {
          "surface": "http",
          "method": "GET",
          "path": "/invalid-record",
          "handler": "secure_echo",
          "posture": "invalid"
        }
      ]
    }
  },
  "input": {
    "secure_steps": [
      {
        "name": "missing-record",
        "operation": "http",
        "request": {
          "method": "GET",
          "path": "/missing-record",
          "headers": {},
          "body": {
            "encoding": "utf8",
            "value": ""
          },
          "is_base64": false
        }
      },
      {
        "name": "invalid-record",
        "operation": "http",
        "request": {
          "method": "GET",
          "path": "/invalid-record",
          "headers": {},
          "body": {
            "encoding": "utf8",
            "value": ""
          },
          "is_base64": false
        }
      }
    ]
  },
  "expect": {
    "secure_steps": [
      {
        "name": "missing-record",
        "status": 500,
        "error_code": "app.internal",
        "response": {
          "status": 500,
          "headers": {
            "content-type": [
              "application/json; charset=utf-8"
            ],
            "x-request-id": [
              "req_test_123"
            ]
          },
          "cookies": [],
          "body": {
            "encoding": "utf8",
            "value": "{\"error\":{\"code\":\"app.internal\",\"message\":\"internal error\",\"request_id\":\"req_test_123\"}}"
          },
          "is_base64": false
        },
        "resolver_calls": 0,
        "middleware_calls": 0,
        "handler_calls": 0
      },
      {
        "name": "invalid-record",
        "status": 500,
        "error_code": "app.internal",
        "response": {
          "status": 500,
          "headers": {
            "content-type": [
              "application/json; charset=utf-8"
            ],
            "x-request-id": [
              "req_test_123"
            ]
          },
          "cookies": [],
          "body": {
            "encoding": "utf8",
            "value": "{\"error\":{\"code\":\"app.internal\",\"message\":\"internal error\",\"request_id\":\"req_test_123\"}}"
          },
          "is_base64": false
        },
        "resolver_calls": 0,
        "middleware_calls": 0,
        "handler_calls": 0
      }
    ]
  }
}
